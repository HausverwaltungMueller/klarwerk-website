{
  "name": "dachwerk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && tsx scripts/prerender.ts && npm run seo:emit",
    "preview": "vite preview --outDir dist",
    "lint": "oxlint src scripts",
    "typecheck": "tsc --noEmit",
    "content:lint": "tsx scripts/content-lint.ts",
    "seo:emit": "tsx scripts/generate-sitemap.ts",
    "budget": "tsx scripts/check-budget.ts",
    "contrast": "tsx scripts/check-contrast.ts",
    "links": "tsx scripts/check-links.ts",
    "verify": "npm run budget && npm run links",
    "fonts": "tsx scripts/copy-fonts.ts",
    "og:png": "tsx scripts/build-og-png.ts",
    "check": "npm run typecheck && npm run lint && npm run content:lint && npm run contrast",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource/instrument-serif": "^5.2.5",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "lighthouse": "^13.4.1",
    "oxlint": "^1.20.0",
    "postcss": "^8.5.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.0"
  }
}
